<?xml version="1.0" encoding="utf-8" ?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:tools="http://schemas.android.com/tools"
android:layout_width="match_parent"
android:layout_height="match_parent">
<GridLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:rowCount="2"
    android:columnCount="3"
    android:layout_centerInParent="true"
    android:useDefaultMargins="true">

    <Button
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:text="Go crazy!"
        android:id="@+id/GoCrazyBtn"/>
        <Button
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:text="Look around"
        android:id="@+id/LookAroundBtn"/>
        <Button
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:text="Lightshow"
        android:id="@+id/LightShowBtn"/>
        <Button
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:text="Flash!"
        android:id="@+id/LightFlashBtn"/>
        <Button
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:text="No"
        android:id="@+id/TheNoBtn"/>
        <Button
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:text="Spin!"
        android:id="@+id/SpinBtn"/>
</GridLayout>
 </RelativeLayout>