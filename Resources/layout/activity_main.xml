<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:weightSum="100"
    tools:ignore="MissingDimension">


    <RelativeLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="fill_parent"
        android:id="@+id/linearLayout1"
        android:layout_weight="90">

        <android.webkit.WebView
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_centerHorizontal="true"
            android:id="@+id/camera"
            />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:padding="30px"
            android:weightSum="2"
            >
            <ImageButton
                android:src="@drawable/button_border"
                android:layout_width="100dp"
                android:layout_height="fill_parent"
                android:layout_weight="1"
                android:layout_gravity="center_vertical"
                android:backgroundTint="@color/mtrl_btn_transparent_bg_color"
                android:id="@+id/btnLeft"
                />
            <ImageButton
                android:src="@drawable/BtnRightIcon"
                android:layout_width="100dp"
                android:layout_height="fill_parent"
                android:layout_weight="1"
                android:layout_gravity="center_vertical"
                android:backgroundTint="@color/mtrl_btn_transparent_bg_color"
                android:id="@+id/btnRight" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_alignParentRight="true"
            android:padding="30px"
            android:weightSum="2"
            tools:ignore="MissingDimension">
            <ImageButton
                android:src="@drawable/BtnUpIcon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/mtrl_btn_transparent_bg_color"
                android:layout_weight="1"
                android:id="@+id/btnUp"/>
            <ImageButton
                android:src="@drawable/btndowniconxml"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/mtrl_btn_transparent_bg_color"
                android:layout_weight="1"
                android:id="@+id/btnDown"/>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>